# ~/.zshrc — interactive shells only.
#   ~/.zshenv   → env for every zsh (cargo)
#   ~/.zprofile → login shells (homebrew shellenv)
#   this file   → prompt, completion, history, keys, aliases

# ─────────────────────────────────────────────────────────────── PATH
# GOPATH is $HOME/go; hardcoded rather than `go env GOPATH` to avoid a
# subprocess on every shell start.
path=(
  "$HOME/.local/bin"
  "$HOME/go/bin"
  "${KREW_ROOT:-$HOME/.krew}/bin"
  $path
)

# ─────────────────────────────────────────────────── version managers
eval "$(mise activate zsh)"      # python, uv
eval "$(rbenv init - zsh)"       # ruby

# ───────────────────────────────────────────────────────────── gcloud
GCLOUD_SDK="$HOME/Downloads/google-cloud-sdk"
[[ -f "$GCLOUD_SDK/path.zsh.inc"       ]] && source "$GCLOUD_SDK/path.zsh.inc"
[[ -f "$GCLOUD_SDK/completion.zsh.inc" ]] && source "$GCLOUD_SDK/completion.zsh.inc"

# ──────────────────────────────────────────────────────────── history
HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=50000
setopt SHARE_HISTORY EXTENDED_HISTORY INC_APPEND_HISTORY
setopt HIST_IGNORE_DUPS HIST_IGNORE_SPACE HIST_REDUCE_BLANKS HIST_VERIFY

# ──────────────────────────────────────────────────────── shell opts
setopt AUTO_CD AUTO_PUSHD PUSHD_IGNORE_DUPS PUSHD_SILENT
setopt INTERACTIVE_COMMENTS EXTENDED_GLOB
unsetopt BEEP

# ──────────────────────────────────────────────────────── completion
fpath=("$HOME/.zsh/completions" /opt/homebrew/share/zsh/site-functions $fpath)
autoload -Uz compinit
# Full rebuild at most once a day; otherwise trust the cached dump.
if [[ -n ~/.zcompdump(#qN.mh+24) ]]; then compinit; else compinit -C; fi

zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'   # case-insensitive
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*:descriptions' format '%F{blue}%d%f'
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path "$HOME/.zsh/cache"

# ─────────────────────────────────────────────────────────── keybinds
bindkey -e                                        # emacs mode
autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey '^[[A' up-line-or-beginning-search        # ↑ searches by prefix
bindkey '^[[B' down-line-or-beginning-search      # ↓ searches by prefix
bindkey '^[[1;5C' forward-word                    # ctrl-→
bindkey '^[[1;5D' backward-word                   # ctrl-←
bindkey '^[[H' beginning-of-line
bindkey '^[[F' end-of-line
bindkey '^[[3~' delete-char

# ──────────────────────────────────────────────────────────── aliases
alias k='kubectl'
compdef k=kubectl
alias gcp-auth='BROWSER=firefox-gcp gcloud auth login --update-adc'
# Bastion tunnels are handled by _moz_k8s_config (see custom functions below),
# which opens its own SOCKS proxy on 1701/1702/1703 per realm.

# eza was installed but never wired up
if (( $+commands[eza] )); then
  alias ls='eza --group-directories-first'
  alias ll='eza -l --git --group-directories-first'
  alias la='eza -la --git --group-directories-first'
  alias lt='eza --tree --level=2'
fi

# ─────────────────────────────────────────────────────────── k8s base
# `current-context` in ~/.kube/config is k3s-cloud, which lives in k3s.yaml —
# both files must be in scope or kubectl (and the starship prompt) can't
# resolve it. The mozilla-k8s functions below override KUBECONFIG per cluster.
export KUBECONFIG="$HOME/.kube/config:$HOME/.kube/k3s.yaml"

# ────────────────────────────────────────────────── custom functions
[[ -r "$HOME/.zsh/functions/mozilla-k8s.zsh" ]] && source "$HOME/.zsh/functions/mozilla-k8s.zsh"

# ──────────────────────────────────────────────────────────── secrets
# Mode 600, never committed. See comments in the file for the `op` upgrade.
[[ -r "$HOME/.zsh/secrets.zsh" ]] && source "$HOME/.zsh/secrets.zsh"

# ──────────────────────────────────────────────── fzf (ctrl-r, ctrl-t)
(( $+commands[fzf] )) && source <(fzf --zsh)

# ───────────────────────────────────────────────────────────── prompt
eval "$(starship init zsh)"

# ───────────────────────────────────────────── plugins (order matters)
source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh
source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh  # must be last
